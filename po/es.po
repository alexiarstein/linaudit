#: crates/linaudit-core/src/profile.rs
msgid "Full criteria: every check with its original severity."
msgstr "Criterio completo: todos los controles con su severidad original."

#: crates/linaudit-core/src/profile.rs
msgid "Personal machine: relaxes checks meant for corporate servers (legal banner, password expiry, log forwarding, fail2ban, services such as cups or avahi) and lowers the firewall from HIGH to MEDIUM."
msgstr "Equipo personal: relaja controles pensados para servidores corporativos (banner legal, vencimiento de passwords, envío de logs, fail2ban, servicios como cups o avahi) y baja el firewall de ALTO a MEDIO."

#: crates/linaudit-core/src/profile.rs
msgid "What the host or the runtime manages (clock, AppArmor, auditd, firewall, logs, kernel parameters) is N/A."
msgstr "Lo que gestiona el host o el runtime (reloj, AppArmor, auditd, firewall, logs, parámetros de kernel) queda N/A."

#: crates/linaudit-core/src/profile.rs
msgid "Full criteria, no concessions. For servers, VPSs and exposed machines."
msgstr "Criterio completo, sin concesiones. Para servidores, VPS y máquinas expuestas."

#: crates/linaudit-core/src/profile.rs
msgid "Relaxes what only matters on corporate servers: banner, password expiry, SIEM, cups/avahi."
msgstr "Relaja lo que solo importa en servidores corporativos: banner, vencimiento de passwords, SIEM, cups/avahi."

#: crates/linaudit-core/src/profile.rs
msgid "What the host or the runtime manages (kernel, clock, firewall, logs) is not evaluated."
msgstr "Lo que gestiona el host o el runtime (kernel, reloj, firewall, logs) no se evalúa."

#: crates/linaudit-core/src/profile.rs
msgid "a legal banner is a requirement for corporate servers"
msgstr "el banner legal es un requisito de servidores corporativos"

#: crates/linaudit-core/src/profile.rs
msgid "periodic password expiry does not apply to personal machines"
msgstr "el vencimiento periódico de passwords no aplica a equipos personales"

#: crates/linaudit-core/src/profile.rs
msgid "a personal machine does not usually forward logs to a SIEM"
msgstr "un equipo personal no suele enviar logs a un SIEM"

#: crates/linaudit-core/src/profile.rs
msgid "cups, avahi, bluetooth and ModemManager are normal on a desktop"
msgstr "cups, avahi, bluetooth y ModemManager son normales en un escritorio"

#: crates/linaudit-core/src/profile.rs
msgid "fail2ban protects exposed services; it does not apply to a desktop"
msgstr "fail2ban protege servicios expuestos; no aplica a un escritorio"

#: crates/linaudit-core/src/profile.rs
msgid "the firewall is enforced by the host or the orchestrator"
msgstr "el firewall lo aplica el host o el orquestador"

#: crates/linaudit-core/src/profile.rs
msgid "AppArmor/SELinux is enforced by the host"
msgstr "AppArmor/SELinux lo aplica el host"

#: crates/linaudit-core/src/profile.rs
msgid "auditd runs on the host"
msgstr "auditd corre en el host"

#: crates/linaudit-core/src/profile.rs
